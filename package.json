{
  "name": "@fusionstructure/foundation",
  "private": false,
  "version": "0.1.1",
  "description": "Contratos neutrales de unidades, álgebra lineal, formato de proyecto y compatibilidad para FusionStructure.",
  "license": "MIT",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./foundation": "./dist/foundation.js",
    "./project-format": "./dist/project-format.js",
    "./compatibility": "./dist/compatibility.js"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "vitest run --maxWorkers=1 --pool=threads --no-file-parallelism"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
